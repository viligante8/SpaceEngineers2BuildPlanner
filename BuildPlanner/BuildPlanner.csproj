<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>BuildPlanner</AssemblyName>
    <RootNamespace>BuildPlanner</RootNamespace>

    <!--
      Keep the developer's absolute paths out of the shipped binary.

      Without this the compiler stamps the full build path into the assembly (the debug directory
      entry pointing at obj\Release\BuildPlanner.pdb) and into the SourceLink document map, so a
      released DLL published the machine's user name to everyone who downloaded it. PathMap rewrites
      those to project-relative paths; Deterministic makes the output independent of where it was
      built, which is what makes the rewrite complete rather than partial.
    -->
    <PathMap>$(MSBuildProjectDirectory)=BuildPlanner</PathMap>
    <Deterministic>true</Deterministic>

    <!-- Override with: dotnet build -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">F:\SteamLibrary\steamapps\common\SpaceEngineers2\Game2</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.3" />
  </ItemGroup>

  <!-- The plugin exposes no public API; the unit-tested logic is internal. -->
  <ItemGroup>
    <InternalsVisibleTo Include="BuildPlanner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VRage.Core">        <HintPath>$(GameDir)\VRage.Core.dll</HintPath>        <Private>false</Private></Reference>
    <Reference Include="VRage.Core.Game">   <HintPath>$(GameDir)\VRage.Core.Game.dll</HintPath>   <Private>false</Private></Reference>
    <Reference Include="VRage.Library">     <HintPath>$(GameDir)\VRage.Library.dll</HintPath>     <Private>false</Private></Reference>
    <Reference Include="VRage.Input">       <HintPath>$(GameDir)\VRage.Input.dll</HintPath>       <Private>false</Private></Reference>
    <Reference Include="VRage.DCS">         <HintPath>$(GameDir)\VRage.DCS.dll</HintPath>         <Private>false</Private></Reference>
    <Reference Include="VRage.Game">        <HintPath>$(GameDir)\VRage.Game.dll</HintPath>        <Private>false</Private></Reference>
    <Reference Include="VRage.UI.Shared">   <HintPath>$(GameDir)\VRage.UI.Shared.dll</HintPath>   <Private>false</Private></Reference>
    <!-- ScreenView / ViewBase, the base types of the terminal screen and its view model. -->
    <Reference Include="VRage.UI">          <HintPath>$(GameDir)\VRage.UI.dll</HintPath>          <Private>false</Private></Reference>
    <Reference Include="Game2.Client">      <HintPath>$(GameDir)\Game2.Client.dll</HintPath>      <Private>false</Private></Reference>
    <Reference Include="Game2.Game">        <HintPath>$(GameDir)\Game2.Game.dll</HintPath>        <Private>false</Private></Reference>
    <Reference Include="Game2.Simulation">  <HintPath>$(GameDir)\Game2.Simulation.dll</HintPath>  <Private>false</Private></Reference>
    <Reference Include="Avalonia.Base">     <HintPath>$(GameDir)\Avalonia.Base.dll</HintPath>     <Private>false</Private></Reference>
    <!-- Control, TextBlock and the rest of the terminal panel's tree. -->
    <Reference Include="Avalonia.Controls"> <HintPath>$(GameDir)\Avalonia.Controls.dll</HintPath> <Private>false</Private></Reference>
  </ItemGroup>

</Project>
